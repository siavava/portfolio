{
  "js/ts.tsdk.path": "node_modules/typescript/lib",

  // Not .purs/output: the LSP's purs fork and the CLI toolchain would invalidate each other's externs.
  "purescript-lsp.outputPath": "output",
  "purescript-lsp.globs": [
    "app/**/*.purs",
    "test/**/*.purs",
    "packages/*/src/**/*.purs",
    ".spago/p/*/src/**/*.purs"
  ],
  "purescript-lsp.formatter": "purs-tidy"
}
