{
  "private": true,
  "version": "5.1.1",
  "packageManager": "bun@1.2.22",
  "type": "module",
  "imports": {
    "#purs/*": {
      "types": "./app/types/purs/*.d.ts",
      "default": "./.purs/output/*/index.js"
    }
  },
  "scripts": {
    "notes-meta": "bun run purs:build && bun scripts/build-notes-meta.ts",
    "purs:build": "bun scripts/purs-ffi-stubs.ts && bun run --cwd packages/vue-bridge build && bun scripts/spago-build.ts && bun scripts/purs-dts.ts",
    "purs:check": "bun run purs:build && bun scripts/purs-test.ts",
    "build": "bun run purs:build && bun scripts/build-notes-meta.ts && nuxi build",
    "dev": "bun run purs:build && nuxi dev",
    "generate": "bun run purs:build && bun scripts/build-notes-meta.ts && bun scripts/tikz-cache.ts restore && nuxi generate && bun scripts/tikz-cache.ts save",
    "preview": "nuxi preview",
    "lint": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"content/**/*.md\" \"*.md\"",
    "typecheck": "nuxi typecheck",
    "start": "node .output/server/index.mjs",
    "purs:format": "purs-tidy format-in-place 'app/**/*.purs' 'packages/**/*.purs' 'test/**/*.purs'",
    "purs:format-check": "purs-tidy check 'app/**/*.purs' 'packages/**/*.purs' 'test/**/*.purs'"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@nuxt/content": "3.16.2",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/robots": "^6.2.4",
    "@pinia/nuxt": "^1.0.3",
    "@takumi-rs/core": "^2.16.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@vueuse/core": "^15.0.0",
    "better-sqlite3": "^12.6.2",
    "d3-force": "^3.0.0",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "motion-v": "^2.8.0",
    "node-tikzjax": "^1.0.5",
    "nuxt": "^4.6.1",
    "nuxt-og-image": "^6.10.3",
    "opentype.js": "^2.0.0",
    "pinia": "^4.1.0",
    "playwright-core": "^1.64.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sitemap": "^9.0.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/eslint": "1.17.0",
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/d3-force": "^3.0.10",
    "@typescript-eslint/parser": "^8.71.2",
    "@vercel/blob": "^2.8.2",
    "@vue/language-plugin-pug": "3.3.13",
    "eslint-plugin-vue": "10.11.1",
    "eslint-plugin-vue-pug": "1.0.0-alpha.6",
    "markdownlint-cli2": "^0.23.3",
    "pug": "^3.0.3",
    "purescript": "^0.15.16",
    "purs-tidy": "^0.11.1",
    "sass": "^1.105.2",
    "satori": "^0.62.0",
    "spago": "^1.0.4",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.13"
  }
}
